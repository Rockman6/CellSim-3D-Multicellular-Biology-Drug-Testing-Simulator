#!/usr/bin/env bash
# cellsim — unified CLI wrapper for the Campaign-1 modules.
#
# Run `cellsim <subcommand> [--help]` to see per-subcommand options.
# Activate the cellsim conda env first (conda activate cellsim).
#
# This script just dispatches to `python -m cellsim.<pkg>.<module>`
# with the remaining args. It's intentionally a shell wrapper, not
# a Python console-script entry point, so it works without
# pip-installing the package.

set -euo pipefail

_cellsim_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "${_cellsim_repo}"

# Preflight: friendly error if the conda env isn't active. Python
# must be in PATH for every subcommand below; without it we'd fail
# with a cryptic 'python: command not found' line 140-ish.
if ! command -v python >/dev/null 2>&1; then
    echo "cellsim: 'python' not in PATH." >&2
    echo "" >&2
    echo "  Did you activate the env? Try:" >&2
    echo "    conda activate cellsim" >&2
    echo "" >&2
    echo "  If you don't have the env yet:" >&2
    echo "    mamba env create -f environment.yml" >&2
    echo "" >&2
    exit 2
fi

_usage() {
    cat <<USAGE
usage: cellsim <subcommand> [args...]

  cell-sim    dose-response of one cell line to one drug (Phase-1 engine)
                -> cellsim/cell/engine.py

  cell-stream one population under a dosing schedule -> JSON Lines for a UI
  dish        cells in space (monolayer or spheroid) -> JSON Lines for a UI
  plate       your plate-reader export -> viability, IC50 with a CI, GR metrics
                -> cellsim/cell/stream.py

  validate-gdsc  fit one potency per drug, predict every line vs GDSC
                -> scripts/validate_gdsc.py

  dock        batch docking screen (Layer 1.3)
                ranked CSV ± MC error bars ± auto-profile PNGs
                -> cellsim/dock/batch.py

  dock-one    single-compound dock + biologist viewer
                -> cellsim/dock/viewer.py

  off-target  dock one compound into N receptors (selectivity screen)
                -> cellsim/dock/off_target.py

  triage-png  triage-breakdown PNG dashboard from a batch CSV
                -> cellsim/dock/triage_viewer.py

  shortlist   filter a batch CSV to only follow_up + review rows
                -> cellsim/dock/shortlist.py

  to-md       batch CSV -> markdown table (lab-notebook paste)
                -> cellsim/dock/to_md.py

  redock      single-pair re-dock with crystal-RMSD
                -> cellsim/dock/vina.py

  pocket      fpocket auto binding-site detection
                -> cellsim/dock/pocket_detect.py

  refine      post-dock OpenMM ligand-only minimisation
                (currently python module only, no CLI yet)

  profile     one-page drug profile dashboard
                (3D + SoM + HOMO/LUMO + ADMET + Ro5 callouts)
                -> cellsim/chem/profile.py

  admet       Lipinski / QED / logS / TPSA descriptors
                -> cellsim/chem/admet.py

  parametrize SMILES -> parametrised OpenMM system
                -> cellsim/chem/parametrize.py

  xtb         xTB GFN2 single-point + HOMO/LUMO + charges
                -> cellsim/quantum/xtb.py

  dft         PySCF B3LYP/def2-SVP single-point (rigorous QM)
                -> cellsim/quantum/dft.py

  som         CYP3A4 site-of-metabolism prediction (BDE)
                -> cellsim/quantum/metabolism.py

  som-validate  check SoM predictor against literature sites
                -> cellsim/quantum/som_validation.py

  cyp-inhibit  CYP3A4 inhibition / DDI-risk screen (1TQN dock)
                -> cellsim/dock/cyp_inhibition.py

  fep-hyd     alchemical hydration ΔG for a single SMILES —
                scaffold-only primitive; real hydration gate is
                'cellsim fep-freesolv'
                -> cellsim/fep/__init__.py

  fep-freesolv FreeSolv 12-compound hydration accuracy gate
                (Milestone A, MAE ≤ 1.5 kcal/mol)
                -> cellsim/fep/freesolv_validate.py

  fep-report  analyse a FEP run (hydration or binding) — tarball,
                run dir, or CSV — emit pass/fail verdict +
                parity PNG + normalised CSV
                -> cellsim/fep/report.py

  fep-binding absolute or relative binding ΔG (Milestone B; DDM
                via amber14 + SMIRNOFF-ligand). Subcommands:
                validate / dg / ddg / bench
                -> cellsim/fep/binding.py

  md-ligand   vacuum Langevin MD on a SMILES
                -> cellsim/md/simulate.py

  md-protein  PDB -> solvated OpenMM system + short MD
                -> cellsim/md/protein.py

  md-view     animated protein trajectory viewer
                -> cellsim/md/protein_viewer.py

  uq-mc       Monte-Carlo over Vina seeds (ΔG ± CI)
                -> cellsim/uq/dock_mc.py

  uq-sobol    Sobol sensitivity over docking inputs
                -> cellsim/uq/sobol.py

  fetch-pdb   download a PDB by ID from RCSB
                -> scripts/fetch_pdb.py

  fetch-chembl  drug-like SMILES subset from the ChEMBL API
                -> scripts/fetch_chembl_sample.py

  doctor      end-to-end install sanity check
                -> scripts/doctor.py

  bench-all   biologist dashboard: validate every benchmark YAML
                under benchmarks/fep/ + per-YAML wall estimates
                -> scripts/bench_all_yamls.py

  calib       run one calibration-set YAML + render scatter PNG
                -> scripts/calib_cli.py

  bench       run all bundled benchmarks + aggregate summary
                -> scripts/bench_cli.py

  help        show this message
  version     show cellsim / tool versions

All subcommands accept --help for their own args.
See README.md for the 5-minute biologist quickstart.
USAGE
}

_version() {
    python - <<'PY'
import importlib, importlib.metadata, sys
mods = [
    # (label, import_name, dist_name)
    ("rdkit", "rdkit", "rdkit"),
    ("openmm", "openmm", "openmm"),
    ("openmmtools", "openmmtools", "openmmtools"),
    ("openmmforcefields", "openmmforcefields", "openmmforcefields"),
    ("openff-toolkit", "openff.toolkit", "openff-toolkit"),
    ("openff-interchange", "openff.interchange", "openff-interchange"),
    ("pdbfixer", "pdbfixer", "pdbfixer"),
    ("pymbar", "pymbar", "pymbar"),
    ("vina", "vina", "vina"),
    ("meeko", "meeko", "meeko"),
    ("posebusters", "posebusters", "posebusters"),
    ("xtb", "xtb", "xtb-python"),
    ("pyscf", "pyscf", "pyscf"),
    ("salib", "SALib", "SALib"),
]
print("cellsim   — Campaign-1 non-AI drug-discovery stack")
print("python    ", sys.version.split()[0])
for label, mod_name, dist_name in mods:
    # importlib.metadata is authoritative: it reads the installed
    # distribution's METADATA file, which tracks the actual conda /
    # pip version. Fallback to module.__version__ only if metadata
    # lookup fails, because some packages (e.g. pdbfixer 1.12.0)
    # ship a stale __version__ constant in their code while the
    # real distribution version is higher.
    v = None
    try:
        v = importlib.metadata.version(dist_name)
    except importlib.metadata.PackageNotFoundError:
        pass
    if v is None:
        try:
            mod = importlib.import_module(mod_name)
            v = getattr(mod, "__version__", None)
        except ImportError:
            print(f"{label:<20s} MISSING (env not activated?)")
            continue
    print(f"{label:<20s}", v or "?")
PY
}

case "${1:-}" in
    "" | -h | --help | help)
        _usage ;;
    version | --version | -V)
        _version ;;
    doctor)
        exec python scripts/doctor.py ;;
    bench-all)
        exec python scripts/bench_all_yamls.py ;;
    calib)
        shift; exec python scripts/calib_cli.py "$@" ;;
    bench)
        shift; exec python scripts/bench_cli.py "$@" ;;
    cell-sim)    shift; exec python -m cellsim.cell.engine "$@" ;;
    cell-stream) shift; exec python -m cellsim.cell.stream "$@" ;;
    dish)        shift; exec python -m cellsim.cell.dish "$@" ;;
    plate)       shift; exec python -m cellsim.plate "$@" ;;
    validate-gdsc) shift; exec python scripts/validate_gdsc.py "$@" ;;
    dock)        shift; exec python -m cellsim.dock.batch "$@" ;;
    dock-one)    shift; exec python -m cellsim.dock.viewer "$@" ;;
    off-target)  shift; exec python -m cellsim.dock.off_target "$@" ;;
    triage-png)  shift; exec python -m cellsim.dock.triage_viewer "$@" ;;
    shortlist)   shift; exec python -m cellsim.dock.shortlist "$@" ;;
    to-md)       shift; exec python -m cellsim.dock.to_md "$@" ;;
    redock)      shift; exec python -m cellsim.dock.vina "$@" ;;
    pocket)      shift; exec python -m cellsim.dock.pocket_detect "$@" ;;
    profile)     shift; exec python -m cellsim.chem.profile "$@" ;;
    admet)       shift; exec python -m cellsim.chem.admet "$@" ;;
    parametrize) shift; exec python -m cellsim.chem.parametrize "$@" ;;
    xtb)         shift; exec python -m cellsim.quantum.xtb "$@" ;;
    dft)         shift; exec python -m cellsim.quantum.dft "$@" ;;
    som)         shift; exec python -m cellsim.quantum.metabolism "$@" ;;
    som-validate) shift; exec python -m cellsim.quantum.som_validation "$@" ;;
    cyp-inhibit)  shift; exec python -m cellsim.dock.cyp_inhibition "$@" ;;
    fep-hyd)     shift; exec python -m cellsim.fep "$@" ;;
    fep-freesolv) shift; exec python -m cellsim.fep.freesolv_validate "$@" ;;
    fep-report)   shift; exec python -m cellsim.fep.report "$@" ;;
    fep-binding)  shift; exec python -m cellsim.fep.binding "$@" ;;
    md-ligand)   shift; exec python -m cellsim.md.simulate "$@" ;;
    md-protein)  shift; exec python -m cellsim.md.protein "$@" ;;
    md-view)     shift; exec python -m cellsim.md.protein_viewer "$@" ;;
    uq-mc)       shift; exec python -m cellsim.uq.dock_mc "$@" ;;
    uq-sobol)    shift; exec python -m cellsim.uq.sobol "$@" ;;
    fetch-pdb)    shift; exec python scripts/fetch_pdb.py "$@" ;;
    fetch-chembl) shift; exec python scripts/fetch_chembl_sample.py "$@" ;;
    *)
        echo "cellsim: unknown subcommand '$1'. Run 'cellsim help' for a list." >&2
        exit 2 ;;
esac
